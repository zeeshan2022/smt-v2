---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../data/site';

const title = `Technology Ecosystem — Splunk, QRadar, Palo Alto, Cisco, Azure, AWS | ${SITE.name}`;
const description =
  'The Secure Media Tech technology ecosystem: SIEM (Splunk, IBM QRadar, LogRhythm), firewalls (Palo Alto, Fortinet, Cisco ASA), infrastructure (VMware, Hyper-V, Oracle KVM), cloud (Azure, AWS), forensics (FTK, EnCase, Autopsy) and AI tooling.';

const layers = [
  {
    name: 'Experience Layer',
    icon: 'sparkle',
    color: 'violet',
    techs: ['Projection Mapping', 'Media Servers', 'Interactive Touch', 'Motion Sensors', 'AR / VR', 'Holographic Displays', 'Kinetic Systems', 'Digital Signage'],
  },
  {
    name: 'Intelligence Layer',
    icon: 'brain',
    color: 'cyan',
    techs: ['LLM Pipelines', 'Prompt Engineering', 'RAG Knowledge Systems', 'AI Agents (HITL)', 'Speech-to-Text', 'Python', 'C#', 'AI Assistants'],
  },
  {
    name: 'Security Layer',
    icon: 'shield',
    color: 'green',
    techs: ['Splunk', 'IBM QRadar', 'LogRhythm', 'Palo Alto', 'Fortinet', 'Cisco ASA', 'Snort', 'NetWitness', 'Wireshark', 'SolarWinds'],
  },
  {
    name: 'Forensics & Response Layer',
    icon: 'eye',
    color: 'violet',
    techs: ['FTK', 'EnCase', 'Autopsy', 'Sleuth Kit', 'Hex Analysis', 'Event Correlation', 'Incident Response Playbooks'],
  },
  {
    name: 'Infrastructure Layer',
    icon: 'network',
    color: 'cyan',
    techs: ['Cisco Routing/Switching', 'VLAN', 'VPN', 'MPLS', 'OSPF', 'EIGRP', 'BGP', 'HSRP', 'QoS', 'Windows Server', 'Linux'],
  },
  {
    name: 'Compute & Cloud Layer',
    icon: 'server',
    color: 'green',
    techs: ['VMware', 'Hyper-V', 'Oracle KVM', 'Azure', 'AWS', 'Backup Solutions', 'Disaster Recovery'],
  },
];
---
<PageLayout title={title} description={description}>
  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <SectionHeading
        eyebrow="Technology Ecosystem"
        title="Six layers, one integrated stack"
        sub="From the projector on the pavilion wall to the SIEM alert in the SOC — every layer is engineered and operated by the same team. Hover a layer to see it light up."
      />

      <div class="mt-12 space-y-3">
        {layers.map((l, i) => (
          <div class="reveal group relative rounded-xl border border-line bg-surface p-5 sm:p-6 transition-all hover:border-cyan-glow/60 hover:shadow-[0_0_30px_-8px_rgba(0,229,255,0.35)]">
            <div class="flex items-center gap-4">
              <span class={`w-12 h-12 shrink-0 rounded-lg flex items-center justify-center ${l.color === 'cyan' ? 'bg-cyan-glow/15 text-cyan-glow' : l.color === 'violet' ? 'bg-violet-glow/15 text-violet-glow' : 'bg-green-glow/15 text-green-glow'}`}>
                <Icon name={l.icon} class="w-6 h-6" />
              </span>
              <div class="flex-1">
                <div class="flex items-baseline justify-between gap-3">
                  <h2 class="font-semibold text-white">{l.name}</h2>
                  <span class="font-mono-tech text-[11px] text-gray-400">L{layers.length - i}</span>
                </div>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {l.techs.map((t) => (
                    <li class="text-xs px-2.5 py-1 rounded-full bg-panel border border-line text-gray-300 group-hover:border-cyan-glow/30 transition-colors">{t}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 glass rounded-xl p-6 text-sm text-gray-400 leading-relaxed">
        <p class="font-mono-tech text-cyan-glow text-xs mb-2">// INTEGRATION PRINCIPLE</p>
        A projection rig is a network host. A badge scanner is an attack surface. A concierge kiosk needs patch governance. We design every experience technology as monitored infrastructure — which is why our event work inherits the same SOC, backup and DR discipline as our enterprise work.
      </div>
    </div>
  </section>
  <CTASection />
</PageLayout>
