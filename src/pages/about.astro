---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../data/site';
import { founder, experienceTimeline, expertiseMatrix, industries } from '../data/expertise';

const title = `About ${SITE.name} — Cybersecurity & Event Technology Experts in Dubai | Founded by ${founder.name}`;
const description = `${SITE.founder}, Information Security Associate Manager with 14+ years (CEH, CHFI, CCNA, MCSA, Security+, CISSP), founded Secure Media Tech in Dubai to unite cybersecurity, infrastructure, AI and world-class event technology.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: founder.name,
  jobTitle: 'Founder & Lead, ' + SITE.name,
  knowsAbout: founder.professionalAreas,
  hasCredential: founder.certificationNames.map((c) => ({ '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: c })),
  address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
  worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---
<PageLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="relative radial-glow cyber-grid py-20 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono-tech text-cyan-glow text-xs tracking-[0.25em] uppercase">// About Secure Media Tech</p>
      <h1 class="mt-4 text-4xl sm:text-5xl font-bold leading-tight">
        Not an agency. A <span class="text-gradient">technology company</span> with a security soul and a showman's eye.
      </h1>
      <p class="mt-6 text-lg text-gray-400 max-w-3xl leading-relaxed">
        {SITE.name} is not a generic web agency, marketing shop, hosting reseller or IT support desk.
        We are a Dubai-based technology company focused on cybersecurity, enterprise infrastructure,
        artificial intelligence, automation, event intelligence, interactive experiences, smart venues,
        systems integration and digital transformation.
      </p>
      <p class="mt-4 text-gray-400 max-w-3xl leading-relaxed reveal">
        Our core statement is our operating contract: <strong class="text-white">{SITE.tagline}</strong>
      </p>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-surface border-y border-line">
    <div class="mx-auto max-w-7xl grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 reveal">
        <SectionHeading eyebrow="Founder" title={founder.name} sub={`${founder.title} · ${founder.location} · ${founder.experience} experience`} />
        <div class="mt-6 space-y-4 text-gray-400 leading-relaxed">
          {founder.bio.map((para) => <p>{para}</p>)}
        </div>

        <h3 class="mt-10 text-xl font-semibold text-white">Education</h3>
        <ul class="mt-3 space-y-2">
          {founder.education.map((ed) => (
            <li class="flex items-center gap-3 text-sm text-gray-300"><Icon name="check" class="w-4 h-4 text-cyan-glow" /> {ed.degree} <span class="text-gray-400">({ed.year})</span></li>
          ))}
        </ul>

        <h3 class="mt-8 text-xl font-semibold text-white">Professional Certifications</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          {founder.certificationNames.map((c) => <span class="chip chip-active">{c}</span>)}
        </div>
      </div>

      <aside class="reveal">
        <div class="rounded-xl border border-line bg-panel p-6 sticky top-24">
          <div class="w-full h-40 rounded-lg bg-gradient-to-br from-cyan-glow/20 via-violet-glow/20 to-green-glow/10 cyber-grid flex items-center justify-center">
            <span class="font-display text-5xl font-bold text-white/90">ZH</span>
          </div>
          <p class="mt-4 font-semibold text-white">{founder.name}</p>
          <p class="text-sm text-gray-400">{founder.role}</p>
          <dl class="mt-4 space-y-2 text-sm">
            <div class="flex justify-between"><dt class="text-gray-400">Location</dt><dd class="text-gray-200">{founder.location}</dd></div>
            <div class="flex justify-between"><dt class="text-gray-400">Nationality</dt><dd class="text-gray-200">{founder.nationality}</dd></div>
            <div class="flex justify-between"><dt class="text-gray-400">Experience</dt><dd class="text-gray-200">{founder.experience}</dd></div>
          </dl>
          <div class="mt-4 flex flex-wrap gap-2">
            {founder.certifications.map((c) => <span class="chip">{c}</span>)}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <SectionHeading eyebrow="Track Record" title="Four organisations. One standard." center />
      <ol class="mt-12 relative border-l-2 border-line pl-8 space-y-10 list-none">
        {experienceTimeline.map((job) => (
          <li class="reveal relative">
            <span class="absolute -left-[41px] top-1 w-5 h-5 rounded-full bg-cyan-glow ring-4 ring-base" aria-hidden="true"></span>
            <p class="font-mono-tech text-xs text-green-glow">{job.period}</p>
            <h3 class="mt-1 text-lg font-semibold text-white">{job.role} — {job.company}</h3>
            <div class="mt-2 flex flex-wrap gap-2">
              {job.points.map((p) => <span class="chip">{p}</span>)}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- EXPERTISE MATRIX -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-surface border-y border-line">
    <div class="mx-auto max-w-7xl">
      <SectionHeading eyebrow="Technical Expertise" title="The full capability matrix" sub="Every discipline below is practised hands-on by the team — these are working tools, not résumé keywords." />
      <div class="mt-12 grid md:grid-cols-2 gap-5">
        {Object.entries(expertiseMatrix).map(([domain, skills]) => (
          <div class="reveal rounded-xl border border-line bg-panel p-6">
            <h3 class="font-semibold text-white flex items-center gap-2"><Icon name="cpu" class="w-5 h-5 text-violet-glow" /> {domain}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {skills.map((s) => <span class="chip">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl text-center">
      <SectionHeading eyebrow="Industries Served" title="Twelve sectors, one delivery standard" center />
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        {industries.map((i) => (
          <span class="chip !text-sm !px-4 !py-2 border-cyan-glow/30 text-gray-200">{i}</span>
        ))}
      </div>
    </div>
  </section>

  <CTASection heading="Work directly with the practitioner." sub="No account managers between you and the engineer. Call, WhatsApp, or send a brief — {first reply within one business day}." />
</PageLayout>
