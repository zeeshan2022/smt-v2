---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import CTASection from '../../components/CTASection.astro';
import { products, getProduct } from '../../data/products';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const others = products.filter((x) => x.slug !== p.slug).slice(0, 4);

const title = `${p.title} — ${p.tagline} | ${SITE.name} UAE`;
const description = `${p.title}: ${p.summary.slice(0, 150)}… Deployed and governed by ${SITE.name}, Dubai — cybersecurity-grade AI experience technology for events, venues and enterprises across the UAE.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.title,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, On-premise, Private Cloud',
  offers: { '@type': 'Offer', priceCurrency: 'AED' },
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  featureList: p.features.map((f) => f.name),
  description: p.summary,
};
---
<PageLayout title={title} description={description} ogType="article">
  <script type="application/ld+json" sethtml={JSON.stringify(jsonLd)} slot="header" />
  <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 cyber-grid">
    <div class="mx-auto max-w-5xl">
      <nav aria-label="Breadcrumb" class="text-sm text-gray-400">
        <a href="/" class="hover:text-cyan-glow">Home</a> / <a href="/products" class="hover:text-cyan-glow">Products</a> / <span class="text-gray-300">{p.title}</span>
      </nav>
      <p class="mt-6 font-mono-tech text-xs tracking-[0.3em] text-violet-glow uppercase">{p.code} · {p.category} Product</p>
      <h1 class="mt-2 text-4xl sm:text-5xl font-bold text-white leading-tight">{p.title}</h1>
      <p class="mt-3 text-lg text-cyan-glow">{p.tagline}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/contact" class="btn-primary"><Icon name="arrow" class="w-5 h-5" /> Request a Demo</a>
        <a href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(`Hello ${SITE.name}, I would like a demo of ${p.title}.`)}`} target="_blank" rel="noopener" class="btn-outline"><Icon name="whatsapp" class="w-5 h-5" /> WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="py-14 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-10">
        <div>
          <h2 class="text-2xl font-bold text-white">What it does</h2>
          <p class="mt-4 leading-relaxed text-gray-300">{p.summary}</p>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-white">Features</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {p.features.map((f) => (
              <div class="glass rounded-lg p-4 reveal">
                <h3 class="font-semibold text-cyan-glow flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-green-glow" />{f.name}</h3>
                <p class="mt-1.5 text-sm text-gray-400 leading-relaxed">{f.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <aside class="space-y-6">
        <div class="glass rounded-xl p-6">
          <h3 class="font-semibold text-white">Ideal for</h3>
          <ul class="mt-4 space-y-2 text-sm text-gray-300">
            {p.idealFor.map((i) => (<li class="flex items-start gap-2"><span class="text-violet-glow mt-1">▸</span> {i}</li>))}
          </ul>
        </div>
        <div class="glass rounded-xl p-6">
          <h3 class="font-semibold text-white">Built on</h3>
          <p class="mt-3 text-sm text-gray-400 leading-relaxed">Every {SITE.shortName} product inherits our security engineering DNA: hardened infrastructure, SIEM-monitored operations, human-in-the-loop AI governance and sovereign deployment options (on-prem, private cloud or hybrid).</p>
        </div>
        <div class="rounded-xl border border-cyan-glow/25 bg-surface p-6">
          <h3 class="font-semibold text-white">See it in your venue</h3>
          <p class="mt-2 text-sm text-gray-400">Live walkthroughs run weekly from our Dubai office.</p>
          <a href="/contact" class="btn-primary w-full justify-center mt-4">Book a Session</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="pb-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-xl font-bold text-white mb-6">Explore other products</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((o) => (
          <a href={`/products/${o.slug}`} class="glass rounded-lg p-4 hover:border-cyan-glow/50 transition-colors">
            <span class="font-mono-tech text-[11px] text-violet-glow">{o.code}</span>
            <h3 class="mt-1 text-sm font-semibold text-white">{o.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTASection heading={`Bring ${p.title} to your next event or venue.`} />
</PageLayout>
