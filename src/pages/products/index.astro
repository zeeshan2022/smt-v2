---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CTASection from '../../components/CTASection.astro';
import { products } from '../../data/products';
import { SITE } from '../../data/site';

const categories = ['All', 'Intelligence', 'Experience', 'Venue', 'Security'] as const;

const title = `Products — Event Intelligence, AI Digital Humans & Smart Venue Platforms | ${SITE.name}`;
const description =
  'Ten purpose-built products from Secure Media Tech: Sovereign Event Intelligence, Meeting Intelligence, AI Digital Human, AI Concierge, Venue Command Center, Smart Venue OS, Digital Twin, Event SOC, Knowledge Capture Engine and Smart Badge Platform.';
---
<PageLayout title={title} description={description}>
  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading
        eyebrow="Product Explorer"
        title="Ten products built from real event and enterprise pain points"
        sub="Each product started as a problem solved on-site at EXPO 2020 Dubai, GITEX, AD360 or an enterprise data centre — then engineered into a repeatable platform. Click a category to filter."
      />

      <div class="mt-8 flex flex-wrap gap-2" role="tablist" aria-label="Filter products by category">
        {categories.map((c, i) => (
          <button
            type="button"
            data-filter={c.toLowerCase()}
            class={`px-4 py-2 rounded-full text-sm font-medium border transition-colors ${i === 0 ? 'border-cyan-glow bg-cyan-glow/10 text-cyan-glow' : 'border-line text-gray-400 hover:border-cyan-glow/50 hover:text-cyan-glow'}`}
          >{c}</button>
        ))}
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <a href={`/products/${p.slug}`} data-category={p.category.toLowerCase()} class="glass rounded-xl p-6 hover:border-cyan-glow/50 transition-all reveal group flex flex-col">
            <div class="flex items-center justify-between">
              <span class="font-mono-tech text-xs text-violet-glow">{p.code}</span>
              <span class="text-[11px] uppercase tracking-wider font-mono-tech px-2 py-1 rounded-full border border-line text-gray-400">{p.category}</span>
            </div>
            <h3 class="mt-3 text-lg font-semibold text-white group-hover:text-cyan-glow transition-colors">{p.title}</h3>
            <p class="mt-2 text-sm text-gray-400 leading-relaxed flex-1">{p.tagline}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {p.features.slice(0, 4).map((f) => (
                <li class="text-[11px] px-2 py-1 rounded bg-panel text-gray-300">{f.name}</li>
              ))}
            </ul>
            <span class="mt-4 inline-flex items-center gap-1 text-xs font-mono-tech text-cyan-glow">Open product <Icon name="arrow" class="w-3.5 h-3.5" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTASection />
</PageLayout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('!border-cyan-glow', '!bg-cyan-glow/10', '!text-cyan-glow'));
      btn.classList.add('!border-cyan-glow', '!bg-cyan-glow/10', '!text-cyan-glow');
      const f = btn.dataset.filter;
      cards.forEach((c) => {
        c.style.display = f === 'all' || c.dataset.category === f ? '' : 'none';
      });
    })
  );
</script>
