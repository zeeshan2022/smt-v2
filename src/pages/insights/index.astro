---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = `Insights — Cybersecurity, AI & Event Technology Blog | ${SITE.name}`;
const description =
  'Field notes and technical perspectives from Secure Media Tech: zero trust for live events, sovereign AI for government summits, projection rigs as infrastructure and penetration testing for UAE regulators.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${SITE.name} Insights`,
  url: `${SITE.url}/insights`,
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    datePublished: p.data.pubDate.toISOString(),
    author: { '@type': 'Person', name: p.data.author },
    url: `${SITE.url}/insights/${p.slug}`,
  })),
};
---
<PageLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="header" />
  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <SectionHeading
        eyebrow="Insights"
        title="Written from control rooms, pavilions and data centres — not content mills"
        sub="Operational lessons from EXPO 2020 Dubai, healthcare IT, SOC floors and interactive installations across the GCC."
      />
      <div class="mt-12 space-y-6">
        {posts.map((post) => (
          <a href={`/insights/${post.slug}`} class="glass rounded-xl p-6 sm:p-8 block hover:border-cyan-glow/50 transition-colors reveal group">
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono-tech">
              <span class="px-2 py-1 rounded-full border border-line text-violet-glow uppercase tracking-wider">{post.data.category}</span>
              <span class="text-gray-500">{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              <span class="text-gray-500">· {post.data.readTime} read</span>
            </div>
            <h2 class="mt-3 text-xl sm:text-2xl font-bold text-white group-hover:text-cyan-glow transition-colors">{post.data.title}</h2>
            <p class="mt-2 text-gray-400 leading-relaxed">{post.data.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-mono-tech text-cyan-glow">Read article <Icon name="arrow" class="w-4 h-4" /></span>
          </a>
        ))}
      </div>
      <div class="mt-12 glass rounded-xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h3 class="font-semibold text-white">Looking for deeper reference material?</h3>
          <p class="text-sm text-gray-400 mt-1">Frameworks, checklists and architecture notes live in our Knowledge Center.</p>
        </div>
        <a href="/knowledge-center" class="btn-outline shrink-0">Knowledge Center <Icon name="arrow" class="w-4 h-4" /></a>
      </div>
    </div>
  </section>
  <CTASection heading="Have a problem worth writing about? Let's solve it together." />
</PageLayout>
