---
import PageLayout from '../../../layouts/PageLayout.astro';
import Icon from '../../../components/Icon.astro';
import CTASection from '../../../components/CTASection.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../../data/site';
import { BLOG_CATEGORIES, normalizeCategory } from '../../../data/blog-categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return BLOG_CATEGORIES.map((cat) => ({
    params: { slug: cat.toLowerCase().replace(/[^a-z0-9]+/g, '-') },
    props: { category: cat, posts: posts.filter((p) => normalizeCategory(p.data.category) === cat) },
  }));
}

const { category, posts } = Astro.props;
const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const title = `${category} Insights & Guides | ${SITE.name}`;
const description = `Expert writing on ${category} from Secure Media Tech — Dubai-based engineers with EXPO 2020, SOC and enterprise infrastructure battle experience.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Insights', item: `${SITE.url}/insights` },
    { '@type': 'ListItem', position: 3, name: category, item: `${SITE.url}/insights/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}` },
  ],
};
---
<PageLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="header" />
  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <nav aria-label="Breadcrumb" class="text-sm text-gray-400">
        <a href="/" class="hover:text-cyan-glow">Home</a> / <a href="/insights" class="hover:text-cyan-glow">Insights</a> / <span class="text-gray-300">{category}</span>
      </nav>
      <h1 class="mt-5 text-4xl font-bold leading-tight">{category}</h1>
      <p class="mt-3 text-gray-300 max-w-2xl">All articles filed under {category}. {sorted.length} article{sorted.length === 1 ? '' : 's'}.</p>

      <div class="mt-10 space-y-6">
        {sorted.map((post) => (
          <a href={`/insights/${post.slug}`} class="glass rounded-xl p-6 sm:p-8 block hover:border-cyan-glow/50 transition-colors reveal group">
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono-tech">
              <span class="px-2 py-1 rounded-full border border-line text-violet-glow uppercase tracking-wider">{normalizeCategory(post.data.category)}</span>
              <span class="text-gray-400">{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              <span class="text-gray-400">· {post.data.readTime} read</span>
            </div>
            <h2 class="mt-3 text-xl sm:text-2xl font-bold text-white group-hover:text-cyan-glow transition-colors">{post.data.title}</h2>
            <p class="mt-2 text-gray-300 leading-relaxed">{post.data.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-mono-tech text-cyan-glow">Read article <Icon name="arrow" class="w-4 h-4" /></span>
          </a>
        ))}
        {sorted.length === 0 && (
          <p class="glass rounded-xl p-8 text-gray-300">New articles for this category are in production. Meanwhile, browse <a href="/insights" class="text-cyan-glow underline">all insights</a>.</p>
        )}
      </div>
    </div>
  </section>
  <CTASection />
</PageLayout>
