---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import CTASection from '../../components/CTASection.astro';
import { solutions } from '../../data/solutions';
import { services } from '../../data/services';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const key = s.slug.split('-')[0];
const relatedServices = services.filter((sv) =>
  sv.title.toLowerCase().includes(key)
).slice(0, 3);
if (relatedServices.length < 3) {
  relatedServices.push(...services.filter((sv) => !relatedServices.includes(sv)).slice(0, 3 - relatedServices.length));
}

const title = `${s.title} Solutions in Dubai & UAE | ${SITE.name}`;
const description = `${s.summary} ${SITE.name} delivers ${s.title.toLowerCase()} solutions across the UAE — cybersecurity Dubai, AI solutions UAE, smart venue solutions and event technology Dubai, led by 14+ years of enterprise experience.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  serviceType: s.title,
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  areaServed: ['AE', 'SA', 'QA', 'KW', 'BH', 'OM'],
  description: s.summary,
};
---
<PageLayout title={title} description={description} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="header" />
  <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 cyber-grid">
    <div class="mx-auto max-w-5xl">
      <nav aria-label="Breadcrumb" class="text-sm text-gray-400">
        <a href="/" class="hover:text-cyan-glow">Home</a> / <a href="/solutions" class="hover:text-cyan-glow">Solutions</a> / <span class="text-gray-300">{s.title}</span>
      </nav>
      <span class="mt-6 inline-flex w-14 h-14 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-glow/25 to-violet-glow/25 text-cyan-glow">
        <Icon name={s.icon} class="w-8 h-8" />
      </span>
      <h1 class="mt-5 text-4xl sm:text-5xl font-bold text-white leading-tight">{s.title}</h1>
      <p class="mt-3 text-lg text-cyan-glow font-medium">{s.summary}</p>
    </div>
  </section>

  <section class="py-14 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-6">
        <h2 class="text-2xl font-bold text-white">Overview</h2>
        <p class="leading-relaxed text-gray-300">{s.description}</p>
        <h2 class="text-2xl font-bold text-white pt-4">Capabilities</h2>
        <ul class="space-y-3">
          {s.capabilities.map((c) => (
            <li class="flex items-start gap-3 text-gray-300">
              <Icon name="check" class="w-5 h-5 mt-0.5 text-green-glow shrink-0" /> {c}
            </li>
          ))}
        </ul>
      </div>
      <aside class="space-y-6">
        <div class="glass rounded-xl p-6">
          <h3 class="font-semibold text-white">Outcomes you can measure</h3>
          <ul class="mt-4 space-y-3 text-sm text-gray-300">
            {s.outcomes.map((o) => (
              <li class="flex items-start gap-2"><span class="text-cyan-glow mt-1">▸</span> {o}</li>
            ))}
          </ul>
        </div>
        <div class="glass rounded-xl p-6">
          <h3 class="font-semibold text-white">Related services</h3>
          <ul class="mt-4 space-y-2 text-sm">
            {relatedServices.map((sv) => (
              <li><a class="text-cyan-glow hover:underline" href={`/services/${sv.slug}`}>{sv.title}</a></li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-cyan-glow/25 bg-surface p-6">
          <h3 class="font-semibold text-white">Talk to a certified engineer</h3>
          <p class="mt-2 text-sm text-gray-400">CEH · CHFI · CCNA · MCSA · Security+ · CISSP-track leadership with EXPO 2020 Dubai operations experience.</p>
          <a href="/contact" class="btn-primary w-full justify-center mt-4">Request a Consultation</a>
        </div>
      </aside>
    </div>
  </section>
  <CTASection heading={`Ready to strengthen your ${s.title.toLowerCase()} posture?`} />
</PageLayout>
