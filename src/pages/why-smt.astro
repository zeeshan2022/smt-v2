---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { SITE } from '../data/site';
import { founder } from '../data/expertise';

const title = `Why Secure Media Tech — Cybersecurity + AI + Event Technology in One Firm | ${SITE.name}`;
const description =
  'Secure Media Tech is not an IT company, digital agency, event company or security firm. We are the intersection: certified cybersecurity, enterprise infrastructure, AI and world-stage interactive technology under one accountable roof.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is Secure Media Tech a cybersecurity company or an events company?',
      acceptedAnswer: { '@type': 'Answer', text: 'Both halves are real. The founder runs security governance as an Information Security Associate Manager and delivered 18 projection mapping installations at EXPO 2020 Dubai. SMT exists precisely because those two worlds rarely coexist in one vendor.' },
    },
    {
      '@type': 'Question',
      name: 'How is SMT different from a generic IT support company?',
      acceptedAnswer: { '@type': 'Answer', text: 'IT support companies react. SMT engineers systems to a security baseline from day one — penetration-tested, monitored via SIEM, documented for compliance — then builds intelligent experiences on top of that foundation.' },
    },
    {
      '@type': 'Question',
      name: 'Why does data sovereignty matter for event technology in the GCC?',
      acceptedAnswer: { '@type': 'Answer', text: 'Government and enterprise events generate sensitive transcripts, delegate data and operational telemetry. Our Sovereign Event Intelligence platform keeps processing auditable with human-in-the-loop approval rather than shipping raw content to unknown cloud endpoints.' },
    },
  ],
};

const pillars = [
  { icon: 'shield', title: 'Cybersecurity', text: 'CEH/CHFI-certified offensive testing, CISSP-track governance, Splunk/QRadar/LogRhythm SOC engineering — not a reseller brochure.' },
  { icon: 'network', title: 'Infrastructure', text: 'Cisco routing and switching through BGP/MPLS/QoS depth, VMware/Hyper-V virtualisation, Azure/AWS integration, backup and DR architecture.' },
  { icon: 'brain', title: 'Artificial Intelligence', text: 'Prompt engineering, AI automation, knowledge systems and agents — always with human-in-the-loop guardrails before publication.' },
  { icon: 'sparkle', title: 'Interactive Technology', text: 'Projection mapping, motion-activated installs, laser and kinetic experiences built by the IT Head behind ABRTECH Studio.' },
  { icon: 'radar', title: 'Event Intelligence', text: 'Live transcription, AI summarisation, delegate portals and broadcast engines forged in six months of EXPO 2020 operations.' },
];

const comparisons = [
  { rival: 'Typical IT Company', theySay: '"We manage your servers and tickets."', weDo: 'We secure, monitor and automate the estate — then build intelligence products on top of it.' },
  { rival: 'Digital Marketing Agency', theySay: '"We make things look good."', weDo: 'We make things look good AND pass a penetration test. Every experience ships with segmented networks, hardened endpoints and monitoring.' },
  { rival: 'Event / AV Company', theySay: '"We deliver the show."', weDo: 'We deliver the show and keep it alive for 180 consecutive days — redundancy, spares rotation and incident playbooks are our baseline, learned at EXPO 2020 Dubai.' },
  { rival: 'Pure Cybersecurity Firm', theySay: '"We hand you a PDF audit."', weDo: 'We remediate what we find, integrate the fixes into live operations, and understand why an air-gapped server is useless if the pavilion goes dark.' },
];
---
<PageLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="header" />

  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-line bg-surface radial-glow cyber-grid">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-mono-tech text-cyan-glow text-xs tracking-[0.25em] uppercase">// Why Secure Media Tech</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold leading-tight">Five disciplines.<br />One accountable team.</h1>
      <p class="mt-5 text-lg text-gray-300 leading-relaxed">
        Cybersecurity + Infrastructure + Artificial Intelligence + Interactive Technology + Event Intelligence.
        Hiring four vendors to cover these means four sets of excuses when they collide. We own the whole stack.
      </p>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-5">
        {pillars.map((p) => (
          <div class="reveal rounded-xl border border-line bg-panel p-6">
            <span class="inline-flex w-11 h-11 items-center justify-center rounded-lg bg-cyan-glow/10 text-cyan-glow"><Icon name={p.icon} class="w-6 h-6" /></span>
            <h2 class="mt-4 font-semibold text-white">{p.title}</h2>
            <p class="mt-2 text-sm text-gray-300 leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-surface border-y border-line">
    <div class="mx-auto max-w-5xl">
      <SectionHeading eyebrow="Positioning" title="What we are NOT" sub="The clearest way to explain SMT is to contrast it with the four vendor types you already meet." center />
      <div class="mt-10 space-y-5">
        {comparisons.map((c) => (
          <div class="reveal grid md:grid-cols-2 gap-0 rounded-xl border border-line overflow-hidden">
            <div class="p-6 bg-panel/60">
              <p class="font-mono-tech text-xs text-gray-400 uppercase tracking-wider">{c.rival}</p>
              <p class="mt-2 text-sm italic text-gray-300">{c.theySay}</p>
            </div>
            <div class="p-6 bg-panel border-t md:border-t-0 md:border-l border-line">
              <p class="font-mono-tech text-xs text-green-glow uppercase tracking-wider">Secure Media Tech</p>
              <p class="mt-2 text-sm text-gray-200 leading-relaxed">{c.weDo}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl grid lg:grid-cols-2 gap-10 items-start">
      <div class="reveal">
        <h2 class="text-3xl font-bold leading-tight">Proof lives in the résumé, not the pitch deck</h2>
        <p class="mt-4 text-gray-300 leading-relaxed">
          {founder.name} holds CEH, CHFI, CCNA, MCSA, CompTIA Security+ and CISSP-track credentials with an
          MS in Cyber Security — and the same hands kept eighteen projection rigs running daily through
          EXPO 2020 Dubai while serving as Farnek's IT Engineer on site.
        </p>
        <ul class="mt-6 space-y-3">
          {[
            'Security governance today at Business Systems House (Aug 2024–present)',
            'Healthcare IT, EHR/PACS/HIS and compliance at QAM Healthcare (2022–2024)',
            'IT Head at ABRTECH Studio — "Art Meets Technology" installations since 2021',
            'Deployed for RTA, Dubai Airshow, GITEX, Dubai Police ATM stand, Masdar control centre',
          ].map((t) => (
            <li class="flex items-start gap-3 text-sm text-gray-200"><Icon name="check" class="w-5 h-5 text-green-glow shrink-0" /> {t}</li>
          ))}
        </ul>
      </div>
      <div class="reveal glass rounded-xl p-6 sm:p-8">
        <h3 class="font-mono-tech text-sm text-cyan-glow uppercase tracking-widest">// Engagement model</h3>
        <ol class="mt-5 space-y-4 text-sm text-gray-200">
          <li class="flex gap-3"><span class="font-mono-tech text-violet-glow">01</span><span><strong class="text-white">Assess</strong> — threat modelling, infrastructure audit or venue walkthrough within days, not weeks.</span></li>
          <li class="flex gap-3"><span class="font-mono-tech text-violet-glow">02</span><span><strong class="text-white">Architect</strong> — one design covering security baseline, network, show-control and data flows.</span></li>
          <li class="flex gap-3"><span class="font-mono-tech text-violet-glow">03</span><span><strong class="text-white">Build</strong> — certified engineers and integrators execute; no anonymous subcontractor roulette.</span></li>
          <li class="flex gap-3"><span class="font-mono-tech text-violet-glow">04</span><span><strong class="text-white">Operate</strong> — SOC/NOC monitoring, spares discipline and incident playbooks for as long as it matters.</span></li>
        </ol>
        <a href="/contact" class="btn-primary mt-7 w-full justify-center">Start an Assessment <Icon name="arrow" class="w-4 h-4" /></a>
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>
