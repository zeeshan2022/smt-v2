---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CTASection from '../../components/CTASection.astro';
import { caseStudies } from '../../data/case-studies';
import { SITE } from '../../data/site';

const title = `Case Studies — Security, Infrastructure & Event Technology Outcomes | ${SITE.name}`;
const description =
  'Deep-dive case studies: sustaining 18 projection mapping installations at EXPO 2020 Dubai, sensor-driven fan zones at AD360, zero-downtime healthcare IT at QAM Healthcare, and designing Sovereign Event Intelligence.';
---
<PageLayout title={title} description={description}>
  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <SectionHeading
        eyebrow="Case Studies"
        title="Challenge → Approach → Result, told honestly"
        sub="Long-form accounts of how certified security engineering and event-grade operations came together on real GCC engagements."
      />
      <div class="mt-12 space-y-8">
        {caseStudies.map((cs) => (
          <article class="glass rounded-xl p-6 sm:p-8 reveal">
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono-tech">
              <span class="px-2 py-1 rounded-full border border-line text-violet-glow uppercase tracking-wider">{cs.sector}</span>
              <span class="text-gray-500">{cs.client} · {cs.year}</span>
            </div>
            <h2 class="mt-3 text-xl sm:text-2xl font-bold text-white leading-snug">{cs.title}</h2>
            <div class="mt-5 grid gap-6 md:grid-cols-3">
              <div>
                <h3 class="text-sm font-semibold text-cyan-glow uppercase tracking-wider font-mono-tech">Challenge</h3>
                <p class="mt-2 text-sm text-gray-400 leading-relaxed">{cs.challenge}</p>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-cyan-glow uppercase tracking-wider font-mono-tech">Approach</h3>
                <ul class="mt-2 space-y-1.5 text-sm text-gray-400">
                  {cs.approach.map((a) => (<li class="flex items-start gap-2"><span class="text-violet-glow mt-0.5">▸</span> {a}</li>))}
                </ul>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-green-glow uppercase tracking-wider font-mono-tech">Results</h3>
                <ul class="mt-2 space-y-1.5 text-sm text-gray-400">
                  {cs.results.map((r) => (<li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 mt-0.5 text-green-glow shrink-0" /> {r}</li>))}
                </ul>
              </div>
            </div>
            <div class="mt-5 pt-4 border-t border-line flex flex-wrap items-center gap-2">
              <span class="text-xs text-gray-500 mr-1">Solution:</span>
              {cs.stack.map((t) => (<span class="text-xs px-2 py-1 rounded bg-panel border border-line text-cyan-glow">{t}</span>))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <CTASection heading="Every engagement above started with one WhatsApp message." />
</PageLayout>
