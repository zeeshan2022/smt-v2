---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CTASection from '../../components/CTASection.astro';
import { caseStudies } from '../../data/case-studies';
import { SITE } from '../../data/site';

const title = `Case Studies — EXPO 2020 Dubai, Dubai Airshow, GITEX, RTA, Dubai Police, Masdar, NYUAD | ${SITE.name}`;
const description =
  'Verified Secure Media Tech case studies: 18 projection mapping installations at EXPO 2020 Dubai, interactive installations at Dubai Airshow and GITEX, RTA deployments, Dubai Police ATM stand, Masdar control centre support and NYUAD experiences.';

// Portfolio highlights beyond the long-form write-ups (from real experience data)
const highlights = [
  { client: 'EXPO 2020 Dubai', year: '2021–2022', tags: ['18 Projection Mapping Installations', 'Interactive Systems', 'Motion Activated Experiences'], icon: 'sparkle' },
  { client: 'Dubai Airshow', year: '2023', tags: ['Interactive Installations', 'Technology Deployment'], icon: 'radar' },
  { client: 'GITEX', year: 'Ongoing', tags: ['Technology Experiences', 'Stand Interactivity'], icon: 'cpu' },
  { client: 'RTA', year: '—', tags: ['Technology Deployment', 'Public-Facing Systems'], icon: 'network' },
  { client: 'Dubai Police', year: 'GITEX', tags: ['ATM Exhibition Stand', 'Secure Interactive Demo'], icon: 'shield' },
  { client: 'Masdar', year: '—', tags: ['Control Center Support', 'Operations Monitoring'], icon: 'eye' },
  { client: 'NYUAD', year: '—', tags: ['Interactive Experiences', 'Campus Technology'], icon: 'badge' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Case Studies', item: `${SITE.url}/case-studies` },
      ],
    },
    ...caseStudies.map((cs) => ({
      '@type': 'Article',
      headline: cs.title,
      about: cs.client,
      datePublished: cs.year,
      author: { '@type': 'Organization', name: SITE.name },
      publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    })),
  ],
};
---
<PageLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="header" />

  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-line bg-surface radial-glow">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-mono-tech text-cyan-glow text-xs tracking-[0.25em] uppercase">// Case Studies</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold leading-tight">Deployed where failure is not an option</h1>
      <p class="mt-5 text-lg text-gray-300 leading-relaxed">
        From six-month world-expo operations to ministerial stands and control centres — every engagement below
        was delivered with security-engineering discipline and show-grade reliability.
      </p>
    </div>
  </section>

  <!-- Client portfolio grid -->
  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <SectionHeading eyebrow="Selected Deployments" title="Seven engagements that define the firm" center />
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {highlights.map((h) => (
          <div class="reveal rounded-xl border border-line bg-panel p-6 flex flex-col">
            <div class="flex items-center justify-between">
              <span class="inline-flex w-10 h-10 items-center justify-center rounded-lg bg-violet-glow/10 text-violet-glow"><Icon name={h.icon} class="w-5 h-5" /></span>
              <span class="font-mono-tech text-xs text-gray-400">{h.year}</span>
            </div>
            <h3 class="mt-4 font-semibold text-white text-lg">{h.client}</h3>
            <ul class="mt-3 space-y-1.5 text-sm text-gray-300">
              {h.tags.map((t) => (<li class="flex items-start gap-2"><span class="text-cyan-glow mt-0.5">▸</span>{t}</li>))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Long-form deep dives -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-surface border-y border-line">
    <div class="mx-auto max-w-5xl">
      <SectionHeading
        eyebrow="Deep Dives"
        title="Challenge → Approach → Result, told honestly"
        sub="Long-form accounts of how certified security engineering and event-grade operations came together on real GCC engagements."
      />
      <div class="mt-12 space-y-8">
        {caseStudies.map((cs) => (
          <article class="glass rounded-xl p-6 sm:p-8 reveal">
            <div class="flex flex-wrap items-center gap-3 text-xs font-mono-tech">
              <span class="px-2 py-1 rounded-full border border-line text-violet-glow uppercase tracking-wider">{cs.sector}</span>
              <span class="text-gray-400">{cs.client} · {cs.year}</span>
            </div>
            <h2 class="mt-3 text-xl sm:text-2xl font-bold text-white leading-snug">{cs.title}</h2>
            <div class="mt-5 grid gap-6 md:grid-cols-3">
              <div>
                <h3 class="text-sm font-semibold text-cyan-glow uppercase tracking-wider font-mono-tech">Challenge</h3>
                <p class="mt-2 text-sm text-gray-300 leading-relaxed">{cs.challenge}</p>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-cyan-glow uppercase tracking-wider font-mono-tech">Approach</h3>
                <ul class="mt-2 space-y-1.5 text-sm text-gray-300">
                  {cs.approach.map((a) => (<li class="flex items-start gap-2"><span class="text-violet-glow mt-0.5">▸</span> {a}</li>))}
                </ul>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-cyan-glow uppercase tracking-wider font-mono-tech">Results</h3>
                <ul class="mt-2 space-y-1.5 text-sm text-gray-300">
                  {cs.results.map((r) => (<li class="flex items-start gap-2"><Icon name="check" class="w-4 h-4 text-green-glow shrink-0 mt-0.5" /> {r}</li>))}
                </ul>
              </div>
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              {cs.stack.map((s) => (<span class="chip">{s}</span>))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</PageLayout>
