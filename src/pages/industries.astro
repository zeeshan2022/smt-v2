---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import CTASection from '../components/CTASection.astro';
import { industryList } from '../data/industries';
import { products } from '../data/products';
import { SITE } from '../data/site';

const title = `Industries Served — Cybersecurity, Smart Venues & Event Technology by Sector | ${SITE.name}`;
const description =
  'Secure Media Tech serves government, healthcare, education, enterprise, events, exhibitions, smart cities, real estate, transportation and hospitality across the UAE and GCC — sector-specific challenges matched to proven solutions.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: `${SITE.url}/industries` },
  ],
};
---
<PageLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="header" />

  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-line bg-surface radial-glow">
    <div class="mx-auto max-w-4xl text-center">
      <p class="font-mono-tech text-cyan-glow text-xs tracking-[0.25em] uppercase">// Industries</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold leading-tight">Technology that speaks your sector's language</h1>
      <p class="mt-5 text-lg text-gray-300 leading-relaxed">
        Twelve industries. One delivery standard. Every engagement below is anchored in production
        experience — EXPO pavilions, hospital systems, ministry governance programmes and trade-show floors.
      </p>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl space-y-10">
      {industryList.map((ind) => (
        <article id={ind.slug} class="glass rounded-xl p-6 sm:p-8 reveal scroll-mt-24">
          <div class="flex items-start gap-4">
            <span class="inline-flex w-12 h-12 shrink-0 items-center justify-center rounded-lg bg-cyan-glow/10 text-cyan-glow">
              <Icon name={ind.icon} class="w-6 h-6" />
            </span>
            <div>
              <h2 class="text-2xl font-bold text-white">{ind.name}</h2>
              <p class="mt-2 text-gray-300 leading-relaxed max-w-3xl">{ind.intro}</p>
            </div>
          </div>
          <div class="mt-6 grid gap-6 md:grid-cols-3">
            <div>
              <h3 class="text-sm font-semibold text-violet-glow uppercase tracking-wider font-mono-tech">Challenges</h3>
              <ul class="mt-2 space-y-1.5 text-sm text-gray-300">
                {ind.challenges.map((c) => (<li class="flex items-start gap-2"><span class="text-violet-glow mt-0.5">▸</span> {c}</li>))}
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-cyan-glow uppercase tracking-wider font-mono-tech">Solutions</h3>
              <ul class="mt-2 space-y-1.5 text-sm text-gray-300">
                {ind.solutions.map((s) => (<li class="flex items-start gap-2"><span class="text-cyan-glow mt-0.5">▸</span> {s}</li>))}
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-green-glow uppercase tracking-wider font-mono-tech">Technologies</h3>
              <div class="mt-2 flex flex-wrap gap-2">
                {ind.technologies.map((t) => (<span class="chip">{t}</span>))}
              </div>
            </div>
          </div>
          <div class="mt-6 pt-5 border-t border-line">
            <h3 class="text-sm font-semibold text-white font-mono-tech uppercase tracking-wider">Relevant Products</h3>
            <div class="mt-3 flex flex-wrap gap-3">
              {ind.products.map((pslug) => {
                const p = products.find((x) => x.slug === pslug);
                return p ? (
                  <a href={`/products/${p.slug}`} class="px-3 py-1.5 rounded-lg border border-line bg-panel text-sm text-cyan-glow hover:border-cyan-glow/60 transition-colors">
                    {p.code} · {p.title}
                  </a>
                ) : null;
              })}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CTASection />
</PageLayout>
