---
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import CTASection from '../../components/CTASection.astro';
import { projects } from '../../data/projects';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const others = projects.filter((x) => x.slug !== p.slug).slice(0, 4);

const title = `${p.title} | ${SITE.name} Case Delivery`;
const description = `${p.summary.slice(0, 160)}…`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: p.title,
  location: { '@type': 'Place', name: p.location },
  organizer: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  description: p.summary,
};
---
<PageLayout title={title} description={description} ogType="article">
  <script type="application/ld+json" sethtml={JSON.stringify(jsonLd)} slot="header" />
  <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 cyber-grid">
    <div class="mx-auto max-w-4xl">
      <nav aria-label="Breadcrumb" class="text-sm text-gray-400">
        <a href="/" class="hover:text-cyan-glow">Home</a> / <a href="/projects" class="hover:text-cyan-glow">Projects</a> / <span class="text-gray-300">{p.client}</span>
      </nav>
      <p class="mt-6 font-mono-tech text-xs tracking-[0.25em] uppercase text-violet-glow">{p.category} · {p.year}</p>
      <h1 class="mt-2 text-3xl sm:text-5xl font-bold text-white leading-tight">{p.title}</h1>
      <p class="mt-3 text-gray-400 flex items-center gap-2"><Icon name="map" class="w-4 h-4 text-cyan-glow" /> {p.location} · Client: {p.client}</p>
    </div>
  </section>

  <section class="py-14 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl grid gap-12 md:grid-cols-3">
      <div class="md:col-span-2 space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-white">Engagement</h2>
          <p class="mt-4 leading-relaxed text-gray-300">{p.summary}</p>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-white">Deliverables</h2>
          <ul class="mt-4 space-y-3">
            {p.deliverables.map((d) => (
              <li class="flex items-start gap-3 text-gray-300"><Icon name="check" class="w-5 h-5 mt-0.5 text-green-glow shrink-0" /> {d}</li>
            ))}
          </ul>
        </div>
      </div>
      <aside class="space-y-6">
        <div class="glass rounded-xl p-6">
          <h3 class="font-semibold text-white">Our role</h3>
          <p class="mt-3 text-sm text-gray-300 leading-relaxed">{p.role}</p>
        </div>
        <div class="glass rounded-xl p-6">
          <h3 class="font-semibold text-white">Technology stack</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {p.technologies.map((t) => (<li class="text-xs px-2.5 py-1 rounded-full bg-panel border border-line text-cyan-glow">{t}</li>))}
          </ul>
        </div>
        <div class="rounded-xl border border-cyan-glow/25 bg-surface p-6">
          <h3 class="font-semibold text-white">Similar scope?</h3>
          <a href="/contact" class="btn-primary w-full justify-center mt-3">Discuss Your Event</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="pb-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-xl font-bold text-white mb-6">More deployments</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {others.map((o) => (
          <a href={`/projects/${o.slug}`} class="glass rounded-lg p-4 hover:border-cyan-glow/50 transition-colors">
            <h3 class="text-sm font-semibold text-white">{o.title}</h3>
            <p class="mt-1 text-xs text-gray-400">{o.client} · {o.year}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTASection />
</PageLayout>
