---
// Lightweight inline SVG icon set (no external icon deps → fast Lighthouse).
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = 'w-6 h-6' } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'shield' && <><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z" /><path d="M9 12l2 2 4-4" /></>}
  {name === 'server' && <><rect x="3" y="4" width="18" height="7" rx="1.5" /><rect x="3" y="13" width="18" height="7" rx="1.5" /><path d="M7 7.5h.01M7 16.5h.01" /></>}
  {name === 'brain' && <><path d="M9 4a3 3 0 0 0-3 3 3 3 0 0 0-1 5.8V15a3 3 0 0 0 4 2.8V19a2 2 0 0 0 4 0V5a1 1 0 0 0-1-1H9z" /><path d="M15 4a3 3 0 0 1 3 3 3 3 0 0 1 1 5.8V15a3 3 0 0 1-4 2.8" /></>}
  {name === 'radar' && <><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><path d="M12 12l6-4" /><circle cx="12" cy="12" r="1" fill="currentColor" /></>}
  {name === 'sparkle' && <><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" /><path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16z" /></>}
  {name === 'building' && <><rect x="4" y="3" width="16" height="18" rx="1.5" /><path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2M11 21v-3h2v3" /></>}
  {name === 'network' && <><circle cx="12" cy="5" r="2.2" /><circle cx="5" cy="19" r="2.2" /><circle cx="19" cy="19" r="2.2" /><path d="M12 7.2v4M12 11.2L6.4 17M12 11.2L17.6 17" /></>}
  {name === 'pulse' && <><path d="M3 12h4l2.5-6 5 12L17 12h4" /></>}
  {name === 'phone' && <><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></>}
  {name === 'whatsapp' && <><path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3z" /><path d="M8.5 9.5c0 3 2 5 4.5 5.5.8.2 1.6-.4 1.7-1.1l.1-.6-2-1-.9 1c-1-.4-1.8-1.2-2.2-2.2l1-.9-1-2-.6.1c-.4.2-.7.7-.6 1.2z" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
  {name === 'map' && <><path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10z" /><circle cx="12" cy="11" r="2.2" /></>}
  {name === 'arrow' && <><path d="M5 12h14M13 6l6 6-6 6" /></>}
  {name === 'check' && <><path d="M4 12.5l5 5L20 6.5" /></>}
  {name === 'download' && <><path d="M12 4v10m0 0l-4-4m4 4l4-4" /><path d="M4 18h16" /></>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16" /></>}
  {name === 'close' && <><path d="M6 6l12 12M18 6L6 18" /></>}
  {name === 'search' && <><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></>}
  {name === 'lock' && <><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></>}
  {name === 'eye' && <><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z" /><circle cx="12" cy="12" r="2.8" /></>}
  {name === 'cpu' && <><rect x="6" y="6" width="12" height="12" rx="2" /><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" /></>}
  {name === 'globe' && <><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3.5 3 14 0 18-3-4-3-14.5 0-18z" /></>}
  {name === 'badge' && <><rect x="4" y="7" width="16" height="13" rx="2" /><path d="M9 7V5a3 3 0 0 1 6 0v2" /><circle cx="12" cy="13" r="2.5" /></>}
  {name === 'chart' && <><path d="M4 20V10M10 20V4M16 20v-8M22 20H2" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></>}
  {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M8 11v5M8 8v.01M12 16v-5a2 2 0 0 1 4 0v5" /></>}
</svg>
