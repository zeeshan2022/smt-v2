---
import Icon from './Icon.astro';
import { SITE, WHATSAPP_URL } from '../data/site';

interface Props {
  heading?: string;
  sub?: string;
}
const {
  heading = 'Let’s build something secure, intelligent and unforgettable.',
  sub = 'Tell us about your event, venue or enterprise challenge. We reply within one business day — usually the same hour on WhatsApp.',
} = Astro.props;
---
<section class="relative py-20 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl rounded-2xl border border-cyan-glow/25 bg-surface cyber-grid p-8 sm:p-12 text-center reveal">
    <h2 class="text-3xl sm:text-4xl font-bold text-white">{heading}</h2>
    <p class="mt-4 text-gray-400 max-w-2xl mx-auto">{sub}</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/contact" class="btn-primary justify-center"><Icon name="arrow" class="w-5 h-5" /> Start a Conversation</a>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener" class="btn-outline justify-center"><Icon name="whatsapp" class="w-5 h-5" /> WhatsApp Us</a>
      <a href={`tel:${SITE.mobile}`} class="btn-outline justify-center"><Icon name="phone" class="w-5 h-5" /> {SITE.mobileDisplay}</a>
    </div>
  </div>
</section>
